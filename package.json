{
  "name": "@edgaze/sdk",
  "version": "0.1.1",
  "description": "Official TypeScript SDK for the Edgaze API: run AI workflows, stream their progress and verify webhooks.",
  "license": "MIT",
  "author": "Edge Platforms, Inc. <support@edgaze.ai>",
  "homepage": "https://www.edgaze.ai/docs/api/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgaze-ai/edgaze-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/edgaze-ai/edgaze-typescript/issues"
  },
  "keywords": [
    "edgaze",
    "ai",
    "workflows",
    "api",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "spec:pull": "node scripts/pull-spec.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:package": "publint --strict && attw --pack . --profile node16",
    "check": "npm run generate:check && npm run typecheck && npm run format:check && npm test && npm run build && npm run lint:package",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.25",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
